{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@jobgraph/core": ["packages/core/src/index.ts"],
      "@jobgraph/core/*": ["packages/core/src/*"],
      "@jobgraph/drivers": ["packages/drivers/src/index.ts"],
      "@jobgraph/channels": ["packages/channels/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/api/src/**/*.ts", "apps/worker/src/**/*.ts"],
  "exclude": ["node_modules", "apps/web"]
}
