/**
 * Check every candidate in scripts/board-candidates.txt against its public job feed and write the ones that answer to
 * packages/core/src/feeds/board-registry.ts. Reads public, unauthenticated JSON only; one request per board, 6 at a time.
 *
 *   npx tsx scripts/verify-boards.mts
 */
import { readFile, writeFile } from "node:fs/promises";
import path from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
type Ats = "greenhouse" | "lever" | "ashby" | "smartrecruiters";

const url = (ats: Ats, t: string) => ({
  greenhouse: `https://boards-api.greenhouse.io/v1/boards/${encodeURIComponent(t)}/jobs`,
  lever: `https://api.lever.co/v0/postings/${encodeURIComponent(t)}?mode=json&limit=1`,
  ashby: `https://api.ashbyhq.com/posting-api/job-board/${encodeURIComponent(t)}`,
  smartrecruiters: `https://api.smartrecruiters.com/v1/companies/${encodeURIComponent(t)}/postings?limit=1`,
})[ats];

async function count(ats: Ats, token: string): Promise<number | null> {
  try {
    const res = await fetch(url(ats, token), { headers: { accept: "application/json", "user-agent": "NoriBoardCheck/1.0" }, signal: AbortSignal.timeout(15_000) });
    if (!res.ok) return null;
    const j: any = await res.json();
    if (ats === "greenhouse") return Array.isArray(j.jobs) ? (j.meta?.total ?? j.jobs.length) : null;
    if (ats === "lever") return Array.isArray(j) ? j.length : null;
    if (ats === "ashby") return Array.isArray(j.jobs) ? j.jobs.length : null;
    return typeof j.totalFound === "number" ? j.totalFound : null;
  } catch { return null; }
}

const lines = (await readFile(path.join(ROOT, "scripts/board-candidates.txt"), "utf8")).split(/\r?\n/).filter((l) => l.trim() && !l.startsWith("#"));
const seen = new Set<string>();
const cands = lines.map((l) => { const [ats, token, ...n] = l.split(":"); return { ats: ats as Ats, token, name: n.join(":").trim() }; })
  .filter((c) => { const k = `${c.ats}:${c.token}`; if (seen.has(k)) return false; seen.add(k); return true; });

const ok: { ats: Ats; token: string; name: string; open: number }[] = [];
const bad: string[] = [];
let i = 0;
await Promise.all(Array.from({ length: 6 }, async () => {
  while (i < cands.length) {
    const c = cands[i++];
    const n = await count(c.ats, c.token);
    if (n === null) bad.push(`${c.ats}:${c.token}`); else if (n > 0) ok.push({ ...c, open: n }); else bad.push(`${c.ats}:${c.token} (0 jobs)`);
  }
}));

ok.sort((a, b) => a.name.localeCompare(b.name));
const out = `// Generated by scripts/verify-boards.mts: boards whose public feed answered with open jobs. Do not edit by hand.
import type { AtsType } from "../db/schema.js";
import { EARLY_CAREER_BOARDS } from "./board-registry-early-career.js";

export type BoardEntry = { atsType: AtsType; token: string; name: string };

export const VERIFIED_AT = ${JSON.stringify(new Date().toISOString().slice(0, 10))};

const VERIFIED_BOARDS: BoardEntry[] = [
${ok.map((c) => `  { atsType: "${c.ats}", token: ${JSON.stringify(c.token)}, name: ${JSON.stringify(c.name)} },`).join("\n")}
];

/** The generated list plus the curated early-career boards (see board-registry-early-career.ts), without duplicates. */
export const BOARD_REGISTRY: BoardEntry[] = [
  ...VERIFIED_BOARDS,
  ...EARLY_CAREER_BOARDS.filter((e) => !VERIFIED_BOARDS.some((b) => b.atsType === e.atsType && b.token === e.token)),
];
`;
await writeFile(path.join(ROOT, "packages/core/src/feeds/board-registry.ts"), out);
const by = (a: Ats) => ok.filter((c) => c.ats === a).length;
console.log(`checked ${cands.length}; kept ${ok.length} (greenhouse ${by("greenhouse")}, lever ${by("lever")}, ashby ${by("ashby")}, smartrecruiters ${by("smartrecruiters")}); open jobs total ${ok.reduce((s, c) => s + c.open, 0)}`);
console.log(`dropped ${bad.length}: ${bad.sort().join(", ")}`);
