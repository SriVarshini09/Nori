# Leave DATABASE_URL unset to use embedded PGlite in ./data/pglite (dev).
# DATABASE_URL=postgres://jobgraph:jobgraph@localhost:5432/jobgraph

# Anthropic key enables LLM extraction, tailoring and answer generation.
# Without it, heuristic fallbacks run so the pipeline still works end to end.
# ANTHROPIC_API_KEY=sk-ant-...

API_PORT=4000
WEB_URL=http://localhost:3000

# Safety: the driver never clicks submit unless this is "true" AND the run was approved.
ALLOW_REAL_SUBMIT=false

# Hackathon version
# Model tiers. Users can store their own key in Settings (Sign in with Cline); these are the hosted defaults.
# HOSTED_LLM_PROVIDER=cline            # cline | openai-compatible | anthropic | ollama
# HOSTED_LLM_BASE_URL=https://api.cline.bot/api/v1
# HOSTED_LLM_API_KEY=
# HOSTED_LLM_QUALITY_MODEL=deepseek/deepseek-v4-pro
# HOSTED_LLM_BULK_MODEL=qwen/qwen3.7-plus
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_TIMEOUT_MS=180000                # give up on a stalled model after this long and use the heuristic fallback
# OLLAMA_NUM_CTX=                      # context window to assume for the local model (default: read from Ollama). Ollama ships with 4096,
#                                      # too small for tailoring: start Ollama with OLLAMA_CONTEXT_LENGTH=16384
# ALLOW_PRIVATE_MODEL_URLS=1           # production only: let users point Nori at Ollama / LM Studio on this same host (single-user setups). Off by default so a shared server never calls internal addresses.
# LOCAL_ONLY=1                         # force Ollama, refuse cloud models
# CREDENTIALS_KEY=                     # 32 bytes base64 for encrypting stored user keys (falls back to APP_SECRET)
# APP_SECRET=
# EMBED_WORKER=1                       # run scheduler and channels inside the API (npm run demo sets this)
# AGENT_TICK_MINUTES=20
# BRIEF_HOUR=8
# CHANNEL_CONSOLE=1                    # talk to the agent in the terminal

# Production (see docs/deploy.md)
# NODE_ENV=production                  # session cookie becomes Secure
# DATABASE_URL=postgres://user:pass@ep-xxx.us-west-2.aws.neon.tech/neondb?sslmode=require
# ARTIFACTS_DIR=/data/artifacts        # resume PDFs and screenshots; mount a volume here (Dockerfile and fly.toml set it)
# WEB_URL=https://jobs.norinote.xyz    # the one browser origin CORS allows, with credentials
# COOKIE_DOMAIN=.norinote.xyz          # ONLY when the browser calls the API cross-origin (no Next.js proxy): cookie becomes SameSite=None; Domain=<this>
# PARALLEL_API_KEY=
# COMPOSIO_API_KEY=
# RESEND_API_KEY=                      # account emails (reset, confirm) through Resend ...
# SMTP_URL=smtp://user:password@smtp.example.com:587   # ... or through any SMTP server (smtps:// for port 465)
# EMAIL_FROM=Nori <hello@your-domain>   # required with either
# TELEGRAM_BOT_TOKEN=
# Web app (set in Vercel, not here): NEXT_PUBLIC_USE_MOCK=0, API_URL=https://api.norinote.xyz, NEXT_PUBLIC_API_URL=https://api.norinote.xyz
